  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8000\" \"npm --prefix frontend run dev\"",
